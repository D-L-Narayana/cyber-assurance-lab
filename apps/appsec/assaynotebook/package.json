{
  "name": "assaynotebook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-local web-assessment notebook: a deterministic in-tab lab application with four seeded flaws, declarative oracles, finding dedup, severity rationale, SHA-256 evidence hashes and a retest state machine.",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 6112 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 6112 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@radix-ui/react-toggle-group": "1.1.19",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "engines": { "node": ">=20" }
}
