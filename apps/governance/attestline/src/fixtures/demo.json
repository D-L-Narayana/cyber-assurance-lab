  "sodRules": [
    {
      "id": "sod-payroll",
      "name": "Create vs approve payroll",
      "conflict": [
        "payroll.create",
        "payroll.approve"
      ],
      "rationale": "One person must not both prepare and approve a payroll run."
    },
    {
      "id": "sod-ap",
      "name": "Vendor master vs payment release",
      "conflict": [
        "vendor.create",
        "payment.release"
      ],
      "rationale": "Creating a vendor and releasing payments to it enables fictitious-vendor fraud."
    },
    {
      "id": "sod-prod",
      "name": "Repository admin vs production admin",
      "conflict": [
        "repo.admin",
        "prod.admin"
      ],
      "rationale": "Separates change authorship from production deployment authority."
    }
  ]
}
