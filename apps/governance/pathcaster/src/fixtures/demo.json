    },
    {
      "id": "tx-prod-vault",
      "name": "Production admin + vault read",
      "a": {
        "assetId": "a-prod",
        "action": "admin"
      },
      "b": {
        "assetId": "a-vault",
        "action": "read"
      },
      "rationale": "Full control of production plus its secrets."
    },
    {
      "id": "tx-payroll-wh",
      "name": "Payroll write + warehouse read",
      "a": {
        "assetId": "a-payroll",
        "action": "write"
      },
      "b": {
        "assetId": "a-wh",
        "action": "read"
      },
      "rationale": "Can edit source data and read the analytics copy."
    }
