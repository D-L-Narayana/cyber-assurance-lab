{
  "name": "tenure",
  "private": true,
  "version": "0.1.0",
  "description": "Educational data inventory and retention graph: normalises a synthetic data catalog, builds a system-to-system lineage graph, detects orphaned elements, stale owners, retention inflation, purpose drift and unmapped transfers, and schedules retention reviews. Browser-local synthetic data only.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "fast-check": "^4.0.0",
    "jsdom": "^29.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.0.0"
  }
}
